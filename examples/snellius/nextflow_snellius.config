// examples/snellius/nextflow_snellius.config — pass via NXF_CONFIG in the config.
// Keeps the repo's Nextflow settings and changes only where the container is
// cached and how many chunks run in parallel; neither affects the results.
includeConfig '../../nextflow/nextflow.config'

singularity {
    enabled    = true
    autoMounts = true
    // One shared cache for all chromosome jobs (set NXF_SINGULARITY_CACHEDIR in
    // SLURM_SETUP). Without it, every chromosome job pulls the image into its
    // own folder.
    cacheDir   = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: 'singularity'
}

// mvgwas-nf default: 1 CPU per 500-variant chunk, so a job with SLURM_CPUS=8
// runs 8 chunks at a time (the repo config asks 2 CPUs / 8 GB per chunk).
process {
    cpus   = 1
    memory = '4 GB'
}
